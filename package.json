{
  "name": "mswnlink",
  "version": "0.3.1",
  "description": "A simple local-network remote desktop with optional unattended access.",
  "main": "main.js",
  "author": "mswnlink contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node launch.js",
    "rebuild:native": "electron-rebuild -f -w robotjs",
    "dist:fedora": "electron-builder --linux AppImage --publish never",
    "dist:win": "electron-builder --win portable --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist": "electron-builder --publish never",
    "check": "node --check launch.js && node --check main.js && node --check preload.js && node --check renderer.js && node --check theme-init.js && node --check linux-wayland-input.js && node --check scripts/after-pack.cjs"
  },
  "dependencies": {
    "ws": "^8.18.3",
    "dbus-next": "^0.10.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mswnlink.lan",
    "productName": "mswnlink",
    "asar": true,
    "asarUnpack": [
      "node_modules/robotjs/**/*.node"
    ],
    "files": [
      "launch.js",
      "main.js",
      "preload.js",
      "renderer.js",
      "theme-init.js",
      "index.html",
      "styles.css",
      "assets/**/*",
      "package.json",
      "linux-wayland-input.js",
      "build/entitlements.mac.plist",
      "build/entitlements.mac.inherit.plist"
    ],
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "mswnlink-windows-${version}-${arch}.${ext}",
      "icon": "assets/mswnlink.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "artifactName": "mswnlink-macos-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "mswnlink needs Screen Recording permission to share the display you select with a computer on your local network. Screen capture starts only after you click Start sharing.",
        "NSAccessibilityUsageDescription": "mswnlink uses Accessibility permission for mouse and keyboard control during a remote-control session that you authorize."
      },
      "icon": "assets/mswnlink.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "executableName": "mswnlink",
      "artifactName": "mswnlink-fedora-${version}-${arch}.${ext}",
      "icon": "assets/mswnlink.png"
    },
    "afterPack": "scripts/after-pack.cjs",
    "portable": {
      "requestExecutionLevel": "user"
    },
    "toolsets": {
      "appimage": "1.0.3"
    }
  },
  "optionalDependencies": {
    "robotjs": "^0.9.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  }
}
