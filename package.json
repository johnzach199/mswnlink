{
  "name": "mswnlink",
  "version": "0.2.0",
  "description": "A simple remote desktop for computers on your local network.",
  "main": "main.js",
  "author": "mswnlink contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node launch.js",
    "rebuild:native": "electron-rebuild -f -w robotjs",
    "dist:fedora": "electron-builder --linux AppImage --publish never",
    "dist:win": "electron-builder --win portable --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist": "electron-builder --publish never",
    "check": "node --check launch.js && node --check main.js && node --check preload.js && node --check renderer.js && node --check input-backend.js && node --check scripts/after-pack.cjs && python3 -m py_compile native/wayland-input.py"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mswnlink.lan",
    "productName": "mswnlink",
    "asar": true,
    "asarUnpack": [
      "node_modules/robotjs/**/*.node"
    ],
    "files": [
      "launch.js",
      "main.js",
      "preload.js",
      "renderer.js",
      "input-backend.js",
      "index.html",
      "styles.css",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "mswnlink-windows-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "artifactName": "mswnlink-macos-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "mswnlink shares your screen with computers you allow on your network."
      },
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "executableName": "mswnlink",
      "artifactName": "mswnlink-fedora-${version}-${arch}.${ext}"
    },
    "afterPack": "scripts/after-pack.cjs",
    "portable": {
      "requestExecutionLevel": "user"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "extraResources": [
      {
        "from": "native/wayland-input.py",
        "to": "wayland-input.py"
      }
    ]
  },
  "optionalDependencies": {
    "robotjs": "^0.9.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  }
}
